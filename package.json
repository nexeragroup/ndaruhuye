{
  "name": "client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --configuration dev",
    "start:ssr": "ng run client:serve-ssr:dev",
    "build": "ng build --configuration prod",
    "build:ssr": "ng run client:build-ssr:prod",
    "watch": "ng build --watch --configuration dev",
    "test": "ng test",
    "start:dev": "ng serve --configuration dev",
    "start:dev:ssr": "ng run client:serve-ssr:dev",
    "build:dev": "ng build --configuration dev",
    "build:dev:ssr": "ng run client:build-ssr:dev",
    "serve:dev:ssr": "node dist/client/dev/ssr/server/server.mjs",
    "start:staging": "ng serve --configuration staging",
    "start:staging:ssr": "ng run client:serve-ssr:staging",
    "build:staging": "ng build --configuration staging",
    "build:staging:ssr": "ng run client:build-ssr:staging",
    "serve:staging:ssr": "node dist/client/staging/ssr/server/server.mjs",
    "start:prod": "ng serve --configuration prod",
    "start:prod:ssr": "ng run client:serve-ssr:prod",
    "build:prod": "ng build --configuration prod",
    "build:prod:ssr": "ng run client:build-ssr:prod",
    "serve:prod:ssr": "node dist/client/prod/ssr/server/server.mjs",
    "serve:ssr:client": "node dist/client/prod/ssr/server/server.mjs",
    "test:proxy": "node --test proxy/create-proxy.test.mjs",
    "test:proxy:integration": "node --test proxy/proxy.integration.test.mjs"
  },
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "dependencies": {
    "@angular/animations": "^22.2.1",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.8",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.4",
    "tslib": "^2.3.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@types/socket.io-client": "^3.0.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
